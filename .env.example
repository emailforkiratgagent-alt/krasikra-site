# Copy to .env for local development. Never commit real values.

# PostgreSQL (docker compose up -d db gives this one)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/krasikra
# Yandex Managed PostgreSQL: CA certificate in PEM (literal \n allowed). Empty locally.
DATABASE_CA_CERT=
DATABASE_POOL_MAX=5

# Payload sessions/JWT. Generate: openssl rand -base64 32
PAYLOAD_SECRET=change-me

# Encrypts the X.Label site token in the database. 32 bytes, base64.
# Generate: openssl rand -base64 32
# Changing it later means re-entering the token in «Интеграция X.Label».
SETTINGS_ENCRYPTION_KEY=

# Public address of the site, no trailing slash (CSRF and admin links).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# true (default) — X-Robots-Tag: noindex and a closed robots.txt. Production: false.
NOINDEX=true

# Local experiments only: let Payload push schema changes without migrations.
# PAYLOAD_DB_PUSH=true
